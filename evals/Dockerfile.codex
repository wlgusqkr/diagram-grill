# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e
FROM node:22.23.2-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5

ARG CODEX_CLI_VERSION=0.149.1

COPY --chown=0:0 runtime/ /opt/diagram-grill-eval/

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        git \
        graphviz \
        python3 \
        python3-pip \
        ripgrep \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install \
        --break-system-packages \
        --no-cache-dir \
        diagrams==0.25.1 \
        graphviz==0.20.3 \
        jsonschema==4.25.1 \
    && npm install --global --omit=dev "@openai/codex@${CODEX_CLI_VERSION}"

RUN groupadd --gid 10001 codex \
    && useradd --uid 10001 --gid 10001 --create-home --shell /bin/sh codex \
    && test "$(codex --version)" = "codex-cli ${CODEX_CLI_VERSION}" \
    && python3 -c 'import diagrams, jsonschema' \
    && chmod 0555 /opt/diagram-grill-eval/*.py \
    && chmod 0555 /opt/diagram-grill-eval/bwrap-wrapper.sh \
    && set -- $(find /usr/local/lib/node_modules/@openai/codex \
        -type f -path '*/codex-resources/bwrap' -print) \
    && test "$#" -eq 1 \
    && cp "$1" /usr/local/bin/bwrap.real \
    && cp /opt/diagram-grill-eval/bwrap-wrapper.sh /usr/local/bin/bwrap \
    && chmod 0555 /usr/local/bin/bwrap /usr/local/bin/bwrap.real

LABEL org.opencontainers.image.title="diagram-grill Codex evaluation runtime" \
      org.opencontainers.image.version="0.149.1" \
      io.diagram-grill.codex-version="0.149.1" \
      io.diagram-grill.runtime-contract="credential-free-agent-v1"

ENV PATH="/usr/local/bin:/usr/bin:/bin" \
    PYTHONDONTWRITEBYTECODE=1

USER 10001:10001
WORKDIR /workspace
ENTRYPOINT ["python3", "-I", "-S", "/opt/diagram-grill-eval/supervisor.py"]
