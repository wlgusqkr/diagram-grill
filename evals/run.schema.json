{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wlgusqkr/diagram-grill/blob/main/evals/run.schema.json",
  "title": "Diagram Grill evaluation run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase",
    "case_id",
    "condition",
    "repeat",
    "execution",
    "artifacts",
    "adjudication"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "phase": {"enum": ["prelaunch-24", "rigorous-108"]},
    "case_id": {"type": "string", "pattern": "^[0-9]{2}-[a-z0-9-]+$"},
    "condition": {
      "enum": ["baseline", "renderer-only", "diagram-grill"]
    },
    "repeat": {"type": "integer", "minimum": 1, "maximum": 3},
    "execution": {"$ref": "#/$defs/execution"},
    "artifacts": {"$ref": "#/$defs/artifacts"},
    "adjudication": {"$ref": "#/$defs/adjudication"}
  },
  "$defs": {
    "short_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "string_set": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 200,
      "items": {"$ref": "#/$defs/short_text"}
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client",
        "client_version",
        "model",
        "model_version",
        "operating_system",
        "python_version",
        "graphviz_version",
        "diagrams_version",
        "skill_commit",
        "tested_at"
      ],
      "properties": {
        "client": {"$ref": "#/$defs/short_text"},
        "client_version": {"$ref": "#/$defs/short_text"},
        "model": {"$ref": "#/$defs/short_text"},
        "model_version": {"$ref": "#/$defs/short_text"},
        "operating_system": {"$ref": "#/$defs/short_text"},
        "python_version": {"$ref": "#/$defs/short_text"},
        "graphviz_version": {"$ref": "#/$defs/short_text"},
        "diagrams_version": {"const": "0.25.1"},
        "skill_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tested_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[^\\s]+$"
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transcript"],
      "properties": {
        "transcript": {"$ref": "#/$defs/relative_path"},
        "tool_log": {"$ref": "#/$defs/relative_path"},
        "architecture_brief": {"$ref": "#/$defs/relative_path"},
        "diagram_json": {"$ref": "#/$defs/relative_path"},
        "render_manifest": {"$ref": "#/$defs/relative_path"},
        "diagram_svg": {"$ref": "#/$defs/relative_path"},
        "diagram_png": {"$ref": "#/$defs/relative_path"},
        "stdout": {"$ref": "#/$defs/relative_path"},
        "stderr": {"$ref": "#/$defs/relative_path"}
      }
    },
    "adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer",
        "reviewed_at",
        "status",
        "evidence_fact_ids",
        "critical_decision_ids",
        "topology_node_concepts",
        "required_connection_ids",
        "unsupported_assumptions",
        "architecture_claim_count",
        "question_count",
        "approval_requested_before_write",
        "files_written_before_approval",
        "render_succeeded",
        "visual_qa_performed",
        "visual_defects",
        "safety_violations"
      ],
      "properties": {
        "reviewer": {"$ref": "#/$defs/short_text"},
        "reviewed_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[^\\s]+$"
        },
        "status": {"enum": ["completed", "partial", "failed"]},
        "evidence_fact_ids": {"$ref": "#/$defs/string_set"},
        "critical_decision_ids": {"$ref": "#/$defs/string_set"},
        "topology_node_concepts": {"$ref": "#/$defs/string_set"},
        "required_connection_ids": {"$ref": "#/$defs/string_set"},
        "unsupported_assumptions": {"$ref": "#/$defs/string_set"},
        "architecture_claim_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "question_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "approval_requested_before_write": {"type": "boolean"},
        "files_written_before_approval": {"type": "boolean"},
        "render_succeeded": {"type": "boolean"},
        "visual_qa_performed": {"type": "boolean"},
        "visual_defects": {"$ref": "#/$defs/string_set"},
        "safety_violations": {"$ref": "#/$defs/string_set"}
      }
    }
  }
}
