# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e
FROM python:3.14.1-slim-bookworm@sha256:5d17fc066275d26bb2ffe05bc89367dc665310200b5f4cfa8b294e97dc679bff

COPY --chown=0:0 responses_proxy.py /opt/diagram-grill-eval/responses_proxy.py

RUN groupadd --gid 10001 evalproxy \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin evalproxy \
    && chmod 0555 /opt/diagram-grill-eval/responses_proxy.py

LABEL org.opencontainers.image.title="diagram-grill evaluation Responses proxy" \
      io.diagram-grill.runtime-contract="stdin-credential-proxy-v1"

ENV PYTHONDONTWRITEBYTECODE=1

USER 10001:10001
ENTRYPOINT ["python3", "-I", "-S", "/opt/diagram-grill-eval/responses_proxy.py"]
