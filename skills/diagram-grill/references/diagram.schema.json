{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wlgusqkr/diagram-grill/blob/main/skills/diagram-grill/references/diagram.schema.json",
  "title": "Diagram Grill Architecture IR",
  "description": "The versioned, reviewable source of truth for a rendered architecture diagram.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "slug",
    "direction",
    "approval",
    "groups",
    "nodes",
    "edges",
    "decisions",
    "assumptions"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference",
      "maxLength": 512
    },
    "schema_version": {
      "const": "1.0"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "direction": {
      "enum": ["LR", "TB"]
    },
    "approval": {
      "$ref": "#/$defs/approval"
    },
    "groups": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/group"
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 400,
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "decisions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "assumptions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/assumption"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["draft", "approved"]
        }
      }
    },
    "file_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "dependentRequired": {
        "line_end": ["line_start"]
      },
      "properties": {
        "kind": {
          "const": "file"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "line_start": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "line_end": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        }
      }
    },
    "decision_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "decision_id"],
      "properties": {
        "kind": {
          "const": "decision"
        },
        "decision_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "evidence": {
      "oneOf": [
        {
          "$ref": "#/$defs/file_evidence"
        },
        {
          "$ref": "#/$defs/decision_evidence"
        }
      ]
    },
    "evidence_list": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "required_evidence_list": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "parent": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "icon", "group", "status", "evidence"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "icon": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^diagrams\\.(?!custom(?:\\.|$))[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.[A-Z][A-Za-z0-9]*$"
        },
        "icon_fallback_for": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "group": {
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": ["observed", "user-approved", "inferred", "unknown"]
        },
        "evidence": {
          "$ref": "#/$defs/required_evidence_list"
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "type", "evidence"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "from": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": ["sync", "async", "event", "data"]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "evidence": {
          "$ref": "#/$defs/required_evidence_list"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "answer"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "answer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "evidence": {
          "$ref": "#/$defs/evidence_list"
        }
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "status", "evidence"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "status": {
          "enum": ["unresolved", "user-approved", "rejected"]
        },
        "evidence": {
          "$ref": "#/$defs/evidence_list"
        }
      }
    }
  }
}
